# ---- Databáze -------------------------------------------------------------
# Vývoj: SQLite soubor. Produkce: přepněte provider v prisma/schema.prisma
# na "postgresql" a vložte connection string.
DATABASE_URL="file:./dev.db"

# ---- Aplikace -------------------------------------------------------------
# Tajný klíč pro podepisování přihlašovacích cookies (min. 32 znaků).
# Vygenerujte např.: openssl rand -base64 48
SESSION_SECRET="zmente-me-na-nahodny-retezec-alespon-32-znaku"

# Veřejná URL aplikace (používá se v odkazech v e-mailech)
APP_URL="http://localhost:3000"

# Povolená e-mailová doména pro registraci
ALLOWED_EMAIL_DOMAIN="gjk.cz"

# ---- E-mail (SMTP) --------------------------------------------------------
# Pokud SMTP_HOST není vyplněn, e-maily se pouze vypisují do konzole
# a ukládají do složky ./mail-outbox (vhodné pro vývoj).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Parkoviště GJK <parkoviste@gjk.cz>"

# ---- První administrátor (použije se při seedu) ---------------------------
ADMIN_EMAIL="admin@gjk.cz"
ADMIN_PASSWORD="Parkoviste123"
ADMIN_NAME="Správce parkoviště"
